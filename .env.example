# Copy to .env. Choose an available Gemini model ID in your account.
# Empty by design: do not rely on an alias changing between experiments.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
EMBED_MODEL=intfloat/multilingual-e5-small
# Optional Hugging Face commit ID for reproducible experiments.
EMBED_REVISION=
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
# Experimental retrieval filter, NOT a probability of correctness.
# Calibrate on your own labeled evaluation set.
RAG_MIN_SCORE=0.75
