# Local AI via Ollama (default mode: free, offline, Vietnamese-capable).
# Works directly with local models such as qwen3:4b, qwen2.5:3b, qwen2.5:7b.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=600

# Optional cloud alternative: set LLM_PROVIDER=gemini and fill both values below.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=

EMBED_MODEL=intfloat/multilingual-e5-small
# Optional Hugging Face commit ID for reproducible experiments.
EMBED_REVISION=
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
# Experimental retrieval filter, NOT a probability of correctness.
# Calibrate on your own labeled evaluation set.
RAG_MIN_SCORE=0.75
