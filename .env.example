# Local AI via Ollama (default recommended mode: free, offline, Vietnamese-capable).
# Install Ollama (https://ollama.com/download) then run: ollama pull qwen2.5:7b
# For weaker/CPU-only laptops (8 GB RAM), you can switch to: OLLAMA_MODEL=qwen2.5:3b
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300

# Optional cloud alternative: set LLM_PROVIDER=gemini and fill both values below.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=

EMBED_MODEL=intfloat/multilingual-e5-small
# Optional Hugging Face commit ID for reproducible experiments.
EMBED_REVISION=
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
# Experimental retrieval filter, NOT a probability of correctness.
# Calibrate on your own labeled evaluation set.
RAG_MIN_SCORE=0.75
